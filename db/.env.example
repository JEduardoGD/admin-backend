# Copy to db/.env and set values for backup_db_register.sh and backup_files_ftp.sh.
# OUTPUT_DIR is relative to this script unless it is an absolute path.
DB_HOST='127.0.0.1'
DB_PORT='3306'
DB_USER='db_user'
DB_PASSWORD=''
DB_NAME='db_register'
OUTPUT_DIR='backups'
ZIP=true
FTP=true
FTP_HOST='ftp.example.com'
FTP_PORT='21'
FTP_USER=''
FTP_PASSWORD=''
FTP_REMOTE_DIR='/backups'

# File backup: top-level files are uploaded to FTP_BACKUP_REMOTE_DIR/YYMMDD_hhmmss.
# Quote paths containing spaces; the FTP_* connection settings above are shared.
FTP_BACKUP_SOURCE_DIR='/route/to/your/local/path/to/backup'
FTP_BACKUP_REMOTE_DIR='/remote/path/destination/to/your/files'
